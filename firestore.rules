rules_version = '2';
// カードゲーム レート表 — Firestore セキュリティルール
// Firebaseコンソール → Firestore Database → ルール に全部貼り付けて「公開」
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function adminPath() { return /databases/$(database)/documents/config/admin; }
    function isAdmin() { return signedIn() && exists(adminPath()) && get(adminPath()).data.uid == me(); }
    function mePath() { return /databases/$(database)/documents/data/users/$(me())/me; }
    function myPid() { return (signedIn() && exists(mePath())) ? get(mePath()).data.get('pid', '') : ''; }
    function chal(id) { return get(/databases/$(database)/documents/challenges/$(id)).data; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function newV(k, d) { return request.resource.data.get(k, d); }
    function oldV(k, d) { return resource.data.get(k, d); }

    // a match moves a rating by at most 32; with a season reset in the same write it may also move toward 1500 (never past it by more than 32)
    function ratingOk(g) {
      return !(g in changed())
        || math.abs(newV(g, 1500) - oldV(g, 1500)) <= 32
        || (seasonUp()
            && newV(g, 1500) >= (oldV(g, 1500) < 1500 ? oldV(g, 1500) : 1500) - 32
            && newV(g, 1500) <= (oldV(g, 1500) > 1500 ? oldV(g, 1500) : 1500) + 32);
    }
    function stepOk(k) { return newV(k, 0) - oldV(k, 0) == 0 || newV(k, 0) - oldV(k, 0) == 1; }
    // season reset: rating only moves toward 1500 (staying on the same side), and only when the season number goes up
    function between15(g) {
      return (newV(g, 1500) - 1500) * (oldV(g, 1500) - 1500) >= 0
        && math.abs(newV(g, 1500) - 1500) <= math.abs(oldV(g, 1500) - 1500);
    }
    function shrinkOk(g) {
      return !(g in changed()) || (seasonUp() && between15(g));
    }
    // genre slots (ygo, dm and g1..g12 added by the admin); each has <slot>_rating/_wins/_losses/_sp
    function slots() { return ['ygo', 'dm', 'g1', 'g2', 'g3', 'g4', 'g5', 'g6', 'g7', 'g8', 'g9', 'g10', 'g11', 'g12']; }
    function rk() { return ['ygo_rating', 'dm_rating', 'g1_rating', 'g2_rating', 'g3_rating', 'g4_rating', 'g5_rating', 'g6_rating', 'g7_rating', 'g8_rating', 'g9_rating', 'g10_rating', 'g11_rating', 'g12_rating']; }
    function allShrink() { return shrinkOk('ygo_rating')
        && shrinkOk('dm_rating')
        && shrinkOk('g1_rating')
        && shrinkOk('g2_rating')
        && shrinkOk('g3_rating')
        && shrinkOk('g4_rating')
        && shrinkOk('g5_rating')
        && shrinkOk('g6_rating')
        && shrinkOk('g7_rating')
        && shrinkOk('g8_rating')
        && shrinkOk('g9_rating')
        && shrinkOk('g10_rating')
        && shrinkOk('g11_rating')
        && shrinkOk('g12_rating'); }
    // in a match only that genre's rating moves; the others can only take a season reset
    function oneMoves(c) { return (c.g + '_rating' == 'ygo_rating' ? ratingOk('ygo_rating') : shrinkOk('ygo_rating'))
        && (c.g + '_rating' == 'dm_rating' ? ratingOk('dm_rating') : shrinkOk('dm_rating'))
        && (c.g + '_rating' == 'g1_rating' ? ratingOk('g1_rating') : shrinkOk('g1_rating'))
        && (c.g + '_rating' == 'g2_rating' ? ratingOk('g2_rating') : shrinkOk('g2_rating'))
        && (c.g + '_rating' == 'g3_rating' ? ratingOk('g3_rating') : shrinkOk('g3_rating'))
        && (c.g + '_rating' == 'g4_rating' ? ratingOk('g4_rating') : shrinkOk('g4_rating'))
        && (c.g + '_rating' == 'g5_rating' ? ratingOk('g5_rating') : shrinkOk('g5_rating'))
        && (c.g + '_rating' == 'g6_rating' ? ratingOk('g6_rating') : shrinkOk('g6_rating'))
        && (c.g + '_rating' == 'g7_rating' ? ratingOk('g7_rating') : shrinkOk('g7_rating'))
        && (c.g + '_rating' == 'g8_rating' ? ratingOk('g8_rating') : shrinkOk('g8_rating'))
        && (c.g + '_rating' == 'g9_rating' ? ratingOk('g9_rating') : shrinkOk('g9_rating'))
        && (c.g + '_rating' == 'g10_rating' ? ratingOk('g10_rating') : shrinkOk('g10_rating'))
        && (c.g + '_rating' == 'g11_rating' ? ratingOk('g11_rating') : shrinkOk('g11_rating'))
        && (c.g + '_rating' == 'g12_rating' ? ratingOk('g12_rating') : shrinkOk('g12_rating')); }
    function curSeason() { return int((request.time.toMillis() - 1791039600000) / 2592000000) + 1; }
    function histOk() { return newV('season', 1) <= curSeason() + 1 && newV('hist', []).size() <= oldV('hist', []).size() + 1; }
    function seasonUp() { return !('season' in resource.data) || newV('season', 1) > oldV('season', 1); }

    // ---- admin (one person, first come; cannot be changed afterwards) ----
    match /config/admin {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me();
      allow update, delete: if false;
    }

    // ---- limited banner (period-limited pack), set by the admin ----
    match /config/banner {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---- supporter rank: the tiers everyone may see ({r:{pid:tier}, names, h:{pid:bool}, nc:{pid:bool}}).
    //      The admin writes it; a player may only flip their own entries in h (hide the badge) and nc (name colour) ----
    match /config/suprank {
      allow read: if signedIn();
      allow write: if isAdmin();
      allow update: if signedIn() && myPid() != ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['h', 'nc'])
        && request.resource.data.get('h', {}).diff(resource.data.get('h', {})).affectedKeys().hasOnly([myPid()])
        && request.resource.data.get('nc', {}).diff(resource.data.get('nc', {})).affectedKeys().hasOnly([myPid()]);
    }

    // ---- monthly pass sale window ({art, st, en}), set by the admin ----
    match /config/passsale {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    // ---- coin gacha period ({start, end}), set by the admin ----
    // ---- update notice: the admin's app writes it once per version; a function sends it to every phone ----
    match /config/update {
      allow read: if signedIn();
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['v', 'title', 'body', 't', 'sent']) && request.resource.data.get('sent', false) == false
        && request.resource.data.v is string && request.resource.data.v.size() <= 40
        && request.resource.data.get('title', '') is string && request.resource.data.get('title', '').size() <= 60
        && request.resource.data.get('body', '') is string && request.resource.data.get('body', '').size() <= 140;
    }
    match /config/coinev {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    // ---- genre weeks ({list: [{g, s, e}]}), set by the admin ----
    match /config/gweek {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---- genre list ({list: [{id, n, off}]}), edited by the admin ----
    match /config/genres {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---- {v}: the admin bumps it so every phone drops its saved copies and reads everything again once ----
    match /config/sync {
      allow read: if signedIn();
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['v']) && request.resource.data.v is int;
    }

    // ---- which player this Google account is ----
    match /data/users/{u}/me {
      allow read, delete: if signedIn() && u == me();
      allow create, update: if signedIn() && u == me() && (
        request.resource.data.pid == ''
        || get(/databases/$(database)/documents/players/$(request.resource.data.pid)).data.get('uid', '') in ['', me()]);
    }

    // ---- players ----
    function ownerUpdate(pid) {
      return (oldV('uid', '') == me() || myPid() == pid)
        && changed().hasOnly(['name', 'eq', 'uid', 'season', 'hist', 'decks'].concat(rk()))
        && newV('uid', '') in ['', me()]
        && (!('decks' in changed()) || (request.resource.data.decks is map && request.resource.data.decks.size() <= 14))
        && ((!changed().hasAny(rk()) && !('hist' in changed()))
            || (seasonUp() && histOk() && allShrink()));
    }
    function claimUpdate(pid) {
      return oldV('uid', '') == '' && changed().hasOnly(['uid']) && newV('uid', '') == me() && myPid() == pid;
    }
    // result of a match: written by the player who confirms the other player's report
    function pUid(id) { return get(/databases/$(database)/documents/players/$(id)).data.get('uid', ''); }
    function twoPeople(c) { return pUid(c.a) != '' && pUid(c.b) != '' && pUid(c.a) != pUid(c.b); }
    function matchUpdateWith(pid, c) {
      return c.st == 'reported' && myPid() in [c.a, c.b] && pid in [c.a, c.b] && c.rep.by != myPid() && twoPeople(c)
        && c.g in slots()
        && changed().hasOnly(['last_cid', 'peak', 'season', 'hist', c.g + '_wins', c.g + '_losses', c.g + '_sp'].concat(rk()))
        && histOk() && oneMoves(c)
        && stepOk(c.g + '_wins') && stepOk(c.g + '_losses');
    }
    function matchUpdate(pid) {
      return newV('last_cid', '') != '' && newV('last_cid', '') != oldV('last_cid', '')
        && matchUpdateWith(pid, chal(newV('last_cid', '')));
    }
    match /players/{pid} {
      allow read: if signedIn();
      allow create: if isAdmin()
        || (signedIn() && newV('uid', '') == me() && request.resource.data.keys().hasOnly(['name', 'uid', 'inv'])
            // (10/17) 友達招待: who invited this player (an existing player). Only set when the player is created
            && (!('inv' in request.resource.data) || (request.resource.data.inv is string && request.resource.data.inv.size() <= 40
                && exists(/databases/$(database)/documents/players/$(request.resource.data.inv)))));
      allow update: if isAdmin() || (signedIn() && (ownerUpdate(pid) || claimUpdate(pid) || matchUpdate(pid)));
      allow delete: if isAdmin() || (signedIn() && oldV('uid', '') == me());
    }

    // ---- match requests: both players approve the start and the result ----
    function nst() { return request.resource.data.st; }
    function ost() { return resource.data.st; }
    function asKept() { return newV('as', 0) == oldV('as', 0); }
    function transitionOk() {
      return (nst() == 'active' && ost() == 'pending') ? (myPid() == resource.data.b && math.abs(newV('as', 0) - request.time.toMillis()) < 120000)
        : (nst() == 'active') ? (ost() in ['active', 'reported', 'abortreq'] && asKept())
        : (nst() == 'reported') ? (ost() == 'active' && request.resource.data.rep.by == myPid() && asKept()
            && request.time.toMillis() - oldV('as', 0) >= 170000)
        : (nst() == 'done') ? (ost() == 'done' || (ost() == 'reported' && resource.data.rep.by != myPid()))
        : (nst() == 'abortreq') ? (ost() == 'active' && newV('ab', '') == myPid() && asKept())
        : (nst() == 'aborted') ? (ost() == 'pending' || ost() == 'aborted' || (ost() == 'abortreq' ? oldV('ab', '') != myPid()
            : (oldV('bet', 0) == 0 || request.time.toMillis() - oldV('as', 0) < 240000)))
        : (nst() in ['declined', 'cancelled']) ? ost() == 'pending'
        : false;
    }
    // a tournament match: the tour is running, same genre, both players are in it
    function tourOk(tid, d) {
      let T = get(/databases/$(database)/documents/tours/$(tid)).data;
      return T.st == 'live' && T.g == d.g && d.a in T.get('ps', []) && d.b in T.get('ps', []);
    }
    match /challenges/{cid} {
      allow read: if signedIn();
      allow create: if signedIn() && myPid() != '' && request.resource.data.a == myPid() && pUid(request.resource.data.b) != me()
        && request.resource.data.get('bet', 0) is int && request.resource.data.get('bet', 0) >= 0 && request.resource.data.get('bet', 0) <= 500
        && request.resource.data.b != myPid() && request.resource.data.st == 'pending' && request.resource.data.g in slots()
        && (request.resource.data.get('tid', '') == '' || tourOk(request.resource.data.tid, request.resource.data));
      allow update: if isAdmin() || (signedIn() && myPid() in [resource.data.a, resource.data.b]
        && request.resource.data.a == resource.data.a && request.resource.data.b == resource.data.b
        && request.resource.data.g == resource.data.g && request.resource.data.get('bet', 0) == resource.data.get('bet', 0)
        && newV('tid', '') == oldV('tid', '')
        && (newV('da', null) == oldV('da', null) || myPid() == resource.data.a)
        && (newV('db', null) == oldV('db', null) || myPid() == resource.data.b)
        && (ost() == 'pending' || (newV('oa', 0) == oldV('oa', 0) && newV('ob', 0) == oldV('ob', 0)))
        && transitionOk());
      allow delete: if isAdmin() || (signedIn() && myPid() in [resource.data.a, resource.data.b]);
    }

    // ---- finished matches (id = the challenge id) ----
    function matchCreateWith(mid, c) {
      return c.st == 'reported' && myPid() in [c.a, c.b] && c.rep.by != myPid() && twoPeople(c)
        && request.resource.data.cid == mid && request.resource.data.w == c.rep.win
        && request.resource.data.get('bet', 0) == c.get('bet', 0)
        && request.resource.data.get('l', '') == (c.rep.win == c.a ? c.b : c.a)
        && request.resource.data.get('d', 1) is int && request.resource.data.get('d', 1) >= 1 && request.resource.data.get('d', 1) <= 32
        && request.resource.data.get('wr', 1500) is int && request.resource.data.get('wr', 1500) >= 0 && request.resource.data.get('wr', 1500) <= 6000
        && request.resource.data.get('lr', 1500) is int && request.resource.data.get('lr', 1500) >= 0 && request.resource.data.get('lr', 1500) <= 6000
        && nz(request.resource.data.get('tid', '')) == nz(c.get('tid', ''))
        && nz(request.resource.data.get('wd', '')) == nz(c.rep.win == c.a ? c.get('da', '') : c.get('db', ''))
        && nz(request.resource.data.get('ld', '')) == nz(c.rep.win == c.a ? c.get('db', '') : c.get('da', ''));
    }
    function nz(v) { return v == null ? '' : v; }
    match /matches/{mid} {
      allow read: if signedIn();
      allow create: if isAdmin() || (signedIn() && matchCreateWith(mid, chal(mid)));
      allow update, delete: if isAdmin();
    }

    // ---- きもオタTCG friend battles: both players see the match. Each player writes only their own moves (ma / mb),
    //      their own result (wa+ta+ca / wb+tb+cb) once, and the accepter adds their deck and seed part (db, sb) once ----
    match /tcgm/{mid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.a == myPid() && request.resource.data.b != myPid()
        && request.resource.data.st == 'wait' && tcgNow(request.resource.data.t)
        && !('wa' in request.resource.data) && !('wb' in request.resource.data) && !('ta' in request.resource.data) && !('tb' in request.resource.data)
        && !('ca' in request.resource.data) && !('cb' in request.resource.data) && !('db' in request.resource.data) && !('sb' in request.resource.data)
        && request.resource.data.get('mb', []).size() == 0;
      allow update: if signedIn() && (myPid() == resource.data.a || myPid() == resource.data.b)
        && tcgSame('a') && tcgSame('b') && tcgSame('t') && tcgSame('seed') && tcgSame('da')
        && tcgOwnField('wa', resource.data.a) && tcgOwnField('ta', resource.data.a) && tcgOwnField('ca', resource.data.a) && tcgClaimTime('ca')
        && tcgOwnField('wb', resource.data.b) && tcgOwnField('tb', resource.data.b) && tcgOwnField('cb', resource.data.b) && tcgClaimTime('cb')
        && tcgOwnField('db', resource.data.b) && tcgOwnField('sb', resource.data.b)
        && tcgMoves('ma', resource.data.a) && tcgMoves('mb', resource.data.b);
      allow delete: if isAdmin();
    }
    function tcgNow(t) { return t is int && t > request.time.toMillis() - 120000 && t < request.time.toMillis() + 120000; }
    function tcgSame(f) { return request.resource.data.get(f, null) == resource.data.get(f, null); }
    function tcgOwnField(f, owner) {
      return (f in resource.data) ? (f in request.resource.data && request.resource.data[f] == resource.data[f])
        : (!(f in request.resource.data) || myPid() == owner);
    }
    function tcgClaimTime(f) { return (f in resource.data) || !(f in request.resource.data) || tcgNow(request.resource.data[f]); }
    function tcgMoves(f, owner) { return tcgSame(f) || myPid() == owner; }

    // ---- collection / packs (only you and the admin can see yours) ----
    // ---- きもオタTCG live watching: a public summary of a friend battle (no hands, decks or moves).
    //      Only the two players of that match may write it; anyone signed in may watch ----
    // ---- push notifications: your phones' tokens (tk), your choices (p) and a test request (test). Only you; the server reads them ----
    match /push/{pid} {
      allow read, delete: if signedIn() && pid == myPid();
      allow create, update: if signedIn() && pid == myPid() && request.resource.data.keys().hasOnly(['tk', 'p', 'test'])
        && request.resource.data.get('tk', {}) is map && request.resource.data.get('tk', {}).size() <= 10
        && request.resource.data.get('p', {}) is map && request.resource.data.get('p', {}).keys().hasOnly(['ch', 'msg', 'give']);
    }
    match /tcgwatch/{mid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && exists(/databases/$(database)/documents/tcgm/$(mid))
        && (myPid() == get(/databases/$(database)/documents/tcgm/$(mid)).data.a || myPid() == get(/databases/$(database)/documents/tcgm/$(mid)).data.b)
        && request.resource.data.a == get(/databases/$(database)/documents/tcgm/$(mid)).data.a
        && request.resource.data.b == get(/databases/$(database)/documents/tcgm/$(mid)).data.b
        && request.resource.data.keys().hasOnly(['v', 'coins', 'frames', 'a', 'b', 'an', 'bn', 'first', 'seq', 'started', 'updated', 'state'])
        && request.resource.data.updated is int && request.resource.data.seq is int;
      allow delete: if isAdmin();
    }

    // ---- 分身アバターバトル (beta): your avatar, readable by everyone signed in so friends can fight it.
    //      The quest stage moves up one at a time; gacha pulls and opened chests only go up ----
    function bunOk() {
      return request.resource.data.keys().hasOnly(['look', 'al', 'inv', 'eq', 'nid', 'qs', 'gp', 'g10', 'copen', 'u'])
        && request.resource.data.get('inv', []).size() <= 600 && newV('qs', 0) <= 100 && newV('qs', 0) >= 0;
    }
    function bunMine(pid) { return myPid() == pid || get(/databases/$(database)/documents/players/$(pid)).data.get('uid', '') == me(); }
    match /bunshin/{pid} {
      allow read: if signedIn();
      allow create: if signedIn() && bunMine(pid) && bunOk() && newV('qs', 0) <= 1 && newV('gp', 0) == 0 && newV('g10', 0) == 0 && newV('copen', 0) <= 1;
      allow update: if signedIn() && bunMine(pid) && bunOk()
        && newV('qs', 0) >= oldV('qs', 0) && newV('qs', 0) <= oldV('qs', 0) + 1
        && newV('gp', 0) >= oldV('gp', 0) && newV('g10', 0) >= oldV('g10', 0) && newV('copen', 0) >= oldV('copen', 0);
      allow delete: if isAdmin();
    }
    // ---- one record per avatar battle, written by the attacker, never changed ----
    match /bunlog/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && bunMine(request.resource.data.a)
        && request.resource.data.keys().hasOnly(['a', 'd', 'w', 's', 't'])
        && request.resource.data.d is string && request.resource.data.d != request.resource.data.a
        && request.resource.data.w in [0, 1] && request.resource.data.s is int
        && request.resource.data.t is int && math.abs(request.resource.data.t - request.time.toMillis()) < 120000;
      allow update, delete: if false;
    }

    // ---- how many copies of each card a player holds (g: gacha items, t: TCG cards), published by that player for 持っている人○% (v134) ----
    match /own/{pid} {
      allow read: if signedIn();
      allow write: if signedIn() && myPid() == pid
        && request.resource.data.keys().hasOnly(['g', 't', 'u', 'sl', 'sc', 'bx', 'ss'])
        && request.resource.data.get('g', {}) is map && request.resource.data.get('t', {}) is map
        && request.resource.data.get('sl', []) is list && request.resource.data.get('sl', []).size() <= 300
        && request.resource.data.get('sc', []) is list && request.resource.data.get('sc', []).size() <= 45
        && request.resource.data.get('bx', []) is list && request.resource.data.get('bx', []).size() <= 100
        && request.resource.data.get('ss', []) is list && request.resource.data.get('ss', []).size() <= 5;
    }

    // 師匠と弟子 (v134): mentor/{apprentice}_{master}. The apprentice asks (and may take it back), the master answers,
    // either one may end it or mark the graduation (once). A pair that has ended or graduated cannot start again.
    match /mentor/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.a == myPid() && request.resource.data.m != myPid()
        && id == myPid() + '_' + request.resource.data.m && request.resource.data.st == 'req'
        && request.resource.data.keys().hasOnly(['a', 'm', 'st', 't']) && request.resource.data.t is int;
      allow delete: if signedIn() && resource.data.a == myPid() && resource.data.st == 'req';
      allow update: if signedIn() && request.resource.data.a == resource.data.a && request.resource.data.m == resource.data.m && (
           (myPid() == resource.data.m && resource.data.st == 'req' && request.resource.data.st in ['ok', 'no']
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'ok']))
        || (myPid() in [resource.data.a, resource.data.m] && resource.data.st == 'ok' && !('g' in resource.data) && request.resource.data.st == 'end'
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'e']))
        || (myPid() in [resource.data.a, resource.data.m] && resource.data.st == 'ok' && !('g' in resource.data) && !('e' in resource.data)
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['g']) && request.resource.data.g is int));
    }

    // 畑と泥棒 (v134): each player's field, written by that player only (3 plots at most)
    match /farm/{pid} {
      allow read: if signedIn();
      allow write: if signedIn() && myPid() == pid && request.resource.data.keys().hasOnly(['p', 'dog', 'u'])
        && request.resource.data.p is map && request.resource.data.p.size() <= 3;
    }
    // one try per friend per plot: steal/{owner}_{plot}_{thief}; never changed afterwards
    /* ハロウィン (v135): トリック・オア・トリート. The one who asks creates it (3 a day is kept by the app); only the one asked answers, within a day */
    /* ハロウィン (v135): いたずらよけのお守り, public so the one who asks sees it. Only the owner writes */
    // (10/18) TCG CPU「つよい」に勝った数(経験値用・だれでも見える)。1回ずつ、前の記録から15秒以上あけて(回数の上限なし)
    /* (10/19) CPUランク戦: one list per player. r: '?n:<sec>' when a game starts (n = ふつう, s = つよい), the last entry's '?'
       becomes w / l / d at the end. Starts are 15 s apart; a win needs 60 s after its start; a result only within 60 minutes. */
    function tcgcU() { return request.resource.data.u is int && request.resource.data.u <= request.time.toMillis() + 120000 && request.resource.data.u >= request.time.toMillis() - 120000; }
    function tcgcSec(e) { return int(e.split(':')[1]); }
    function tcgcNew(e) { return e is string && e.matches('[?][ns]:[0-9]{9,11}') && math.abs(tcgcSec(e) - request.time.toMillis() / 1000) <= 180; }
    function tcgcFin(o, e) { return o is string && o.matches('[?][ns]:[0-9]{9,11}') && e is string
      && request.time.toMillis() <= tcgcSec(o) * 1000 + 3600000
      && (e == o.replace('[?]', 'l') || e == o.replace('[?]', 'd') || (e == o.replace('[?]', 'w') && request.time.toMillis() >= tcgcSec(o) * 1000 + 60000)); }
    match /tcgc/{pid} {
      allow read: if signedIn();
      allow create: if signedIn() && myPid() == pid && request.resource.data.keys().hasOnly(['r', 'u']) && tcgcU()
        && request.resource.data.r is list && request.resource.data.r.size() == 1 && tcgcNew(request.resource.data.r[0]);
      allow update: if signedIn() && myPid() == pid && request.resource.data.keys().hasOnly(['r', 'u']) && tcgcU()
        && request.resource.data.r is list && resource.data.r is list && (
          (request.resource.data.r.size() == resource.data.r.size() + 1 && request.resource.data.r.size() <= 20000
            && request.resource.data.r[0:resource.data.r.size()] == resource.data.r
            && tcgcNew(request.resource.data.r[resource.data.r.size()])
            && request.resource.data.u >= resource.data.u + 15000)
          || (request.resource.data.r.size() == resource.data.r.size() && resource.data.r.size() > 0
            && request.resource.data.r[0:resource.data.r.size() - 1] == resource.data.r[0:resource.data.r.size() - 1]
            && tcgcFin(resource.data.r[resource.data.r.size() - 1], request.resource.data.r[resource.data.r.size() - 1])));
      allow delete: if isAdmin();
    }
    match /cpux/{pid} {
      allow read: if signedIn();
      allow create: if signedIn() && myPid() == pid && request.resource.data.keys().hasOnly(['n', 'u', 'dd', 'dn'])
        && request.resource.data.n == 1 && request.resource.data.dn == 1 && request.resource.data.dd == today()
        && request.resource.data.u is int && request.resource.data.u <= request.time.toMillis() + 120000;
      allow update: if signedIn() && myPid() == pid && request.resource.data.keys().hasOnly(['n', 'u', 'dd', 'dn'])
        && request.resource.data.n == resource.data.n + 1
        && request.resource.data.u is int && request.resource.data.u >= resource.data.u + 15000 && request.resource.data.u <= request.time.toMillis() + 120000
        && request.resource.data.dd == today()
        && request.resource.data.dn == (resource.data.dd == today() ? resource.data.dn + 1 : 1);
      allow delete: if isAdmin();
    }
    match /hwp/{pid} {
      allow read: if signedIn();
      allow write: if signedIn() && myPid() == pid && request.resource.data.keys().hasOnly(['L', 'u', 'c', 'pc', 'x', 'px', 'S', 'pS'])
        && (!('L' in request.resource.data) || (request.resource.data.L is list && request.resource.data.L.size() <= 20))
        // (10/17) 交換所の経験値 (x / お試し版 px: 100 ずつ、何回でも) とボス戦のスタミナ回復 (S / pS: 使った時刻の list、何回でも)
        && (!('x' in request.resource.data) || (request.resource.data.x is int && request.resource.data.x >= 0 && request.resource.data.x <= 1000000))
        && (!('px' in request.resource.data) || (request.resource.data.px is int && request.resource.data.px >= 0 && request.resource.data.px <= 1000000))
        && (!('S' in request.resource.data) || (request.resource.data.S is list && request.resource.data.S.size() <= 2000))
        && (!('pS' in request.resource.data) || (request.resource.data.pS is list && request.resource.data.pS.size() <= 2000))
        && (!('c' in request.resource.data) || (request.resource.data.c is int && request.resource.data.c >= 0 && request.resource.data.c <= 200000))
        && (!('pc' in request.resource.data) || (request.resource.data.pc is int && request.resource.data.pc >= 0 && request.resource.data.pc <= 200000));
    }
    match /tot/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && myPid() != '' && request.resource.data.f == myPid() && request.resource.data.o is string && request.resource.data.o != myPid()
        && request.resource.data.keys().hasOnly(['f', 'o', 'd', 't', 'st']) && request.resource.data.st == 'ask'
        && request.resource.data.d == int((request.time.toMillis() + 14400000) / 86400000)
        && id == request.resource.data.f + '_' + request.resource.data.o + '_' + string(request.resource.data.d)
        && request.resource.data.t is int && math.abs(request.resource.data.t - request.time.toMillis()) < 300000;
      allow update: if signedIn() && myPid() != '' && resource.data.o == myPid() && resource.data.st == 'ask'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'at']) && request.resource.data.st in ['give', 'no']
        && request.time.toMillis() < resource.data.t + 86400000;
    }
    match /steal/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.p == myPid() && request.resource.data.o != myPid()
        && id == request.resource.data.o + '_' + request.resource.data.pl + '_' + myPid()
        && request.resource.data.keys().hasOnly(['o', 'p', 'pl', 'c', 't', 'n', 'bit', 'f'])
        && request.resource.data.n is int && request.resource.data.n >= 0 && request.resource.data.n <= 300
        && request.resource.data.f is int && request.resource.data.f >= 0 && request.resource.data.f <= 440
        && exists(/databases/$(database)/documents/farm/$(request.resource.data.o));
    }

    // ショーケースのいいね: likes/{owner}__{liker}, one per friend; only the liker makes or removes it
    match /likes/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.p == myPid() && request.resource.data.o != myPid()
        && id == request.resource.data.o + '__' + myPid()
        && request.resource.data.keys().hasOnly(['o', 'p', 't']) && request.resource.data.o is string && request.resource.data.t is int;
      allow delete: if signedIn() && resource.data.p == myPid();
    }

    // ---- 取引所 (v134): auction listings. The seller creates one; others bid (higher each time, before the end); a listing with no bids can be withdrawn ----
    match /auc/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.s == myPid()
        && request.resource.data.keys().hasOnly(['s', 'k', 'c', 'f', 'sp', 'bn', 'end', 't', 'hb', 'hp', 'n', 'g', 'bt'])
        && (!('bt' in request.resource.data) || (request.resource.data.k == 'b' && request.resource.data.bt is int))
        && (!('g' in request.resource.data) || (request.resource.data.k == 't' && request.resource.data.g is int && request.resource.data.g >= 1 && request.resource.data.g <= 10))
        && request.resource.data.k in ['g', 't', 'b', 'h', 's'] && request.resource.data.c is string && request.resource.data.f is bool
        && (request.resource.data.k != 's' || (request.resource.data.c.matches('s[1-9]') && request.resource.data.f == false))
        && (request.resource.data.k != 'h' || (request.resource.data.c.matches('[1-9][0-9]{0,4}') && request.resource.data.f == false))
        && request.resource.data.sp is int && request.resource.data.sp >= 1
        && request.resource.data.bn is int && (request.resource.data.bn == 0 || request.resource.data.bn > request.resource.data.sp)
        && request.resource.data.t is int && math.abs(request.resource.data.t - request.time.toMillis()) < 300000
        && request.resource.data.end is int && request.resource.data.end > request.time.toMillis() + 3000000
        && request.resource.data.end < request.time.toMillis() + 260000000
        && request.resource.data.hb == 0 && request.resource.data.hp == '' && request.resource.data.n == 0;
      allow update: if signedIn() && myPid() != '' && myPid() != resource.data.s
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hb', 'hp', 'n', 'end'])
        && request.resource.data.hp == myPid() && request.time.toMillis() < resource.data.end
        && !(resource.data.bn > 0 && resource.data.hb >= resource.data.bn)
        && request.resource.data.hb is int && request.resource.data.hb > resource.data.hb && request.resource.data.hb >= resource.data.sp
        && request.resource.data.n == resource.data.n + 1
        && (request.resource.data.end == resource.data.end
            || (resource.data.bn > 0 && request.resource.data.hb >= resource.data.bn && request.resource.data.end <= resource.data.end));
      allow delete: if isAdmin() || (signedIn() && resource.data.s == myPid() && resource.data.n == 0);
    }
    // ---- 闇鍋パック (v134): one donated card each. Only the first taker gets it; never changed afterwards ----
    match /yami/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.d == myPid()
        && request.resource.data.keys().hasOnly(['d', 'k', 'c', 'f', 't', 'tb', 'tt'])
        && request.resource.data.k in ['g', 't'] && request.resource.data.c is string && request.resource.data.f is bool
        && request.resource.data.t is int && math.abs(request.resource.data.t - request.time.toMillis()) < 300000
        && request.resource.data.tb == '' && request.resource.data.tt == 0;
      allow update: if signedIn() && myPid() != '' && resource.data.tb == ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tb', 'tt'])
        && request.resource.data.tb == myPid() && request.resource.data.tt is int
        && math.abs(request.resource.data.tt - request.time.toMillis()) < 300000;
      allow delete: if isAdmin();
    }

    // ---- 仲間株 (10/23): one trade per document. Only your own trades; never changed afterwards. Points are worked out from these in the app ----
    match /kabu/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && myPid() != '' && request.resource.data.p == myPid()
        && request.resource.data.keys().hasOnly(['p', 's', 'q', 'x', 't'])
        && request.resource.data.s is string && request.resource.data.s.size() > 0 && request.resource.data.s.size() <= 64
        && request.resource.data.q is int && request.resource.data.q != 0 && request.resource.data.q >= -1000 && request.resource.data.q <= 1000
        && request.resource.data.x is int && request.resource.data.x >= 0 && request.resource.data.x <= 100000000
        && request.resource.data.t is int && request.resource.data.t > request.time.toMillis() - 120000 && request.resource.data.t < request.time.toMillis() + 60000;
      allow update: if false;
      allow delete: if isAdmin();
    }
    // ---- 仲間株: each player's gacha luck per day and the days they opened the app (the stock price uses both). Written by that player's app ----
    match /luck/{pid} {
      allow read: if signedIn();
      // (10/23 audit) only today's luck and today's login can be added or changed; old days can only be dropped
      allow create: if signedIn() && myPid() == pid && luckShape()
        && request.resource.data.lk.keys().hasOnly([string(today())])
        && request.resource.data.get('li', {}).keys().hasOnly([string(today())]);
      allow update: if signedIn() && myPid() == pid && luckShape()
        && request.resource.data.lk.diff(resource.data.get('lk', {})).addedKeys().hasOnly([string(today())])
        && request.resource.data.lk.diff(resource.data.get('lk', {})).changedKeys().hasOnly([string(today())])
        && request.resource.data.get('li', {}).diff(resource.data.get('li', {})).addedKeys().hasOnly([string(today())])
        && request.resource.data.get('li', {}).diff(resource.data.get('li', {})).changedKeys().hasOnly([string(today())]);
    }
    function luckShape() {
      return request.resource.data.keys().hasOnly(['lk', 'li', 'u'])
        && request.resource.data.lk is map && request.resource.data.lk.size() <= 20
        && request.resource.data.get('li', {}) is map && request.resource.data.get('li', {}).size() <= 45
        && request.resource.data.u is int;
    }

    match /inv/{pid} {
      allow read: if isAdmin() || (signedIn() && myPid() == pid);
      allow create: if isAdmin() || (signedIn() && myPid() == pid
        && newV('packs', 0) >= 0 && newV('lpacks', 0) >= 0 && newV('tused', 0) >= 0
        && newV('tpacks', 0) >= 0 && newV('xpacks', 0) >= 0 && newV('xpacks', 0) <= newV('tpacks', 0)
        && newV('pspent', 0) >= 0 && newV('pspent', 0) <= newV('packs', 0) * 100 + newV('lpacks', 0) * 200 + newV('tpacks', 0) * 100 + newV('xpacks', 0) * 80 + newV('hpacks', 0) * 110
        && newV('hpacks', 0) >= 0 && newV('hpacks', 0) <= newV('tpacks', 0)
        && newV('lfree', 0) >= 0 && newV('lfree', 0) <= newV('lpacks', 0)
        && newV('wused', 0) * 350 <= newV('lpacks', 0)
        && newV('hwwu', 0) * 350 <= newV('hwlp', 0) && newV('hwlp', 0) <= newV('lpacks', 0)
        && (newV('mpts', 0) == 0 || (newV('mpts', 0) == 100 && newV('md', -1) == today()))
        && (newV('lbp', 0) == 0 || (newV('lbp', 0) >= 30 && newV('lbp', 0) <= 50 && newV('lbd', -1) == today()))
        && newV('ppp', 0) == 0);
      allow update: if invRvOk() && (isAdmin() || (signedIn() && myPid() == pid
        && newV('packs', 0) >= oldV('packs', 0) && newV('lpacks', 0) >= oldV('lpacks', 0)
        && newV('tused', 0) >= oldV('tused', 0) && (!('tix' in resource.data) || 'tix' in request.resource.data)
        && newV('tpacks', 0) >= oldV('tpacks', 0) && tcgStOk() && tcgNstOk()
        && newV('xpacks', 0) >= oldV('xpacks', 0) && newV('xpacks', 0) - oldV('xpacks', 0) <= newV('tpacks', 0) - oldV('tpacks', 0)
        && newV('hpacks', 0) >= oldV('hpacks', 0) && newV('hpacks', 0) - oldV('hpacks', 0) <= newV('tpacks', 0) - oldV('tpacks', 0)
        && pspentOk() && missionOk() && loginOk() && passOk(pid)
        && newV('hmp', 0) >= oldV('hmp', 0) && newV('hmp', 0) <= 1500   // ハロウィンのイベントミッションのpt(全部で1,290pt)
        && newV('lfree', 0) >= oldV('lfree', 0) && newV('lfree', 0) - oldV('lfree', 0) <= newV('lpacks', 0) - oldV('lpacks', 0)
        && newV('wused', 0) >= oldV('wused', 0)
        && (newV('wused', 0) == oldV('wused', 0) || newV('wused', 0) * 350 <= newV('lpacks', 0))
        && newV('hwlp', 0) >= oldV('hwlp', 0) && newV('hwwu', 0) >= oldV('hwwu', 0)
        && (newV('hwwu', 0) == oldV('hwwu', 0) || newV('hwwu', 0) * 350 <= newV('hwlp', 0))));
      allow delete: if isAdmin();
    }
    // (10/22) a whole inventory written from an old copy is refused, the admin's too: either rv is unchanged (a partial merge)
    // or the write says it was made from the rv the server has now (pr)
    function invRvOk() {
      return request.resource.data.get('rv', '') == resource.data.get('rv', '')
        || request.resource.data.get('pr', '') == resource.data.get('rv', '');
    }

    // daily missions: +100 at most once per day (a day starts at 5:00 JST)
    function today() { return int((request.time.toMillis() + 14400000) / 86400000); }
    function missionOk() {
      return (newV('mpts', 0) == oldV('mpts', 0) && newV('md', -1) == oldV('md', -1))
        || (newV('mpts', 0) == oldV('mpts', 0) + 100 && newV('md', -1) > oldV('md', -1) && newV('md', -1) == today());
    }
    // login bonus: 30-50 at most once per day
    // monthly pass: once a day, at most what the passes active right now give (pass/{pid}: e1/e2/e3 = end time of each grade, written by the admin)
    function passDay(pid) {
      let p = get(/databases/$(database)/documents/pass/$(pid)).data;
      let t = request.time.toMillis();
      return (p.get('e1', 0) > t ? 70 : 0) + (p.get('e2', 0) > t ? 210 : 0) + (p.get('e3', 0) > t ? 350 : 0);
    }
    function passOk(pid) {
      return (newV('ppp', 0) == oldV('ppp', 0) && newV('ppd', -1) == oldV('ppd', -1))
        || (newV('ppd', -1) > oldV('ppd', -1) && newV('ppd', -1) == today()
            && newV('ppp', 0) > oldV('ppp', 0)
            && exists(/databases/$(database)/documents/pass/$(pid))
            && newV('ppp', 0) - oldV('ppp', 0) <= passDay(pid));
    }
    function loginOk() {
      return (newV('lbp', 0) == oldV('lbp', 0) && newV('lbd', -1) == oldV('lbd', -1))
        || (newV('lbd', -1) > oldV('lbd', -1) && newV('lbd', -1) == today()
            && newV('lbp', 0) - oldV('lbp', 0) >= 30 && newV('lbp', 0) - oldV('lbp', 0) <= 50);
    }
    // きもオタTCG: the starter deck is chosen once and never changes
    function tcgSt(d) { return ('tcg' in d) && ('st' in d.tcg) ? d.tcg.st : ''; }
    function tcgStOk() { return tcgSt(resource.data) == '' || tcgSt(request.resource.data) == tcgSt(resource.data); }
    // (10/22) the starter of a new tribe: chosen once, never changed
    function tcgNst(d) { return ('tcg' in d) && ('nst' in d.tcg) ? d.tcg.nst : ''; }
    function tcgNstOk() { return tcgNst(resource.data) == '' || tcgNst(request.resource.data) == tcgNst(resource.data); }
    // purchased points can only be used up by opening packs
    function pspentOk() {
      return newV('pspent', 0) >= oldV('pspent', 0)
        && newV('pspent', 0) - oldV('pspent', 0) <= (newV('packs', 0) - oldV('packs', 0)) * 100 + (newV('lpacks', 0) - oldV('lpacks', 0)) * 200
           + (newV('tpacks', 0) - oldV('tpacks', 0)) * 100 + (newV('xpacks', 0) - oldV('xpacks', 0)) * 80 + (newV('hpacks', 0) - oldV('hpacks', 0)) * 110;
    }

    // ---- predictions on someone else's match, placed within 30 seconds of its start (45s allowed for clock drift); never changed afterwards ----
    function predOk(c) {
      return c.st == 'active' && !(myPid() in [c.a, c.b])
        && request.time.toMillis() - c.get('as', 0) < 45000
        && request.resource.data.pick in [c.a, c.b]
        && request.resource.data.stake is int && request.resource.data.stake >= 10 && request.resource.data.stake <= 500
        && request.resource.data.odds is number && request.resource.data.odds >= 1.05 && request.resource.data.odds <= 4
        && request.resource.data.odds == (request.resource.data.pick == c.a ? c.get('oa', 0) : c.get('ob', 0))
        && request.resource.data.keys().hasOnly(['cid', 'pid', 'pick', 'stake', 'odds', 't', 'g']);
    }
    match /preds/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && myPid() != '' && request.resource.data.pid == myPid()
        && id == request.resource.data.cid + '_' + myPid() && predOk(chal(request.resource.data.cid));
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---- timeline: anyone posts as themselves; afterwards only their own reaction can change ----
    match /feed/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && myPid() != '' && request.resource.data.by == myPid()
        && request.resource.data.keys().hasOnly(['t', 'k', 'by', 'p', 'n', 'x', 'r', 'g'])
        && request.resource.data.r == {} && request.resource.data.x is string && request.resource.data.x.size() <= 140
        && math.abs(request.resource.data.t - request.time.toMillis()) < 300000;
      allow update: if signedIn() && myPid() != ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['r'])
        && request.resource.data.r.diff(resource.data.r).affectedKeys().hasOnly([myPid()])
        && request.resource.data.r.get(myPid(), '') in ['', 'w', 'o', 'k', 'd', 'z'];
      allow delete: if isAdmin();
    }

    // ---- when each player last had the app open: written by that player, readable by the admin only ----
    match /seen/{pid} {
      allow read: if signedIn();
      allow write: if signedIn() && myPid() == pid
        && request.resource.data.keys().hasOnly(['t', 'v'])
        && request.resource.data.t is int && math.abs(request.resource.data.t - request.time.toMillis()) < 300000
        && request.resource.data.get('v', '') is string && request.resource.data.get('v', '').size() <= 16;
    }

    // ---- (10/17) 参加のルールへの同意: each player writes only their own; config/agree {v} (admin) asks everyone again ----
    match /agree/{pid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && myPid() == pid && request.resource.data.keys().hasOnly(['v', 't', 'n'])
        && request.resource.data.v is int && request.resource.data.v >= 1 && request.resource.data.v <= 1000
        && request.resource.data.n is string && request.resource.data.n.size() <= 24;
      allow delete: if isAdmin();
    }
    match /config/agree {
      allow read: if signedIn();
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['v', 't']) && request.resource.data.v is int;
    }

    // ---- messages from the developer to everyone ----
    match /msgs/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---- requests to the developer: anyone sends as themselves, only the admin reads ----
    match /reqs/{id} {
      allow read: if isAdmin();
      allow create: if signedIn() && myPid() != '' && request.resource.data.pid == myPid()
        && request.resource.data.keys().hasOnly(['pid', 'n', 'x', 't'])
        && request.resource.data.x is string && request.resource.data.x.size() > 0 && request.resource.data.x.size() <= 500
        && request.resource.data.n is string && request.resource.data.n.size() <= 40
        && request.resource.data.t is int && math.abs(request.resource.data.t - request.time.toMillis()) < 300000;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---- tournaments: the admin runs them, players enter themselves ----
    match /tours/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /tentry/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && myPid() != '' && request.resource.data.pid == myPid()
        && id == request.resource.data.tid + '_' + myPid()
        && request.resource.data.keys().hasOnly(['tid', 'pid', 't'])
        && get(/databases/$(database)/documents/tours/$(request.resource.data.tid)).data.st == 'entry';
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.pid == myPid());
    }

    // ---- points handed out by the admin ----
    // ---- supporter values: only the admin can read or write them ----
    match /sup/{d} {
      allow read, write: if isAdmin();
    }
    match /suplog/{d} {
      allow read, write: if isAdmin();
    }

    // monthly pass of each player: readable by everyone (it changes XP and shows a badge), written only by the admin
    match /pass/{pid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    // ---- (10/18) 申し込み (orders): a player asks to buy (sends the 応援値 outside the app, writes the code in the memo).
    //      The admin approves from the app (kind: hwpass | hwset | hwp5 | hwp10 (10/20 小袋・大袋) | pt (pl = plan 0-7) | mpass (pl = grade 1-3)). Players only create their own, waiting ones,
    //      and may cancel them while they wait ----
    match /orders/{id} {
      allow read: if isAdmin() || (signedIn() && myPid() != '' && resource.data.pid == myPid());
      allow create: if signedIn() && myPid() != '' && request.resource.data.pid == myPid()
        && request.resource.data.keys().hasOnly(['pid', 'pn', 'kind', 'code', 't', 'st', 'pl'])
        && request.resource.data.st == 'wait' && request.resource.data.kind in ['hwpass', 'hwset', 'hwp5', 'hwp10', 'pt', 'mpass']
        && (request.resource.data.kind != 'pt' || (request.resource.data.get('pl', -1) is int && request.resource.data.get('pl', -1) >= 0 && request.resource.data.get('pl', -1) <= 7))
        && (request.resource.data.kind != 'mpass' || (request.resource.data.get('pl', -1) is int && request.resource.data.get('pl', -1) >= 1 && request.resource.data.get('pl', -1) <= 3))
        && request.resource.data.code is string && request.resource.data.code.size() <= 12
        && request.resource.data.pn is string && request.resource.data.pn.size() <= 40
        && request.resource.data.t is number;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && myPid() != '' && resource.data.pid == myPid() && resource.data.st == 'wait');
    }
    // where to send the 応援値 (the admin's own words); everyone signed in can read it
    // ---- (10/19) a notice the admin sends to every phone once (the server function pushNotice sends it when it is created) ----
    match /notices/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['title', 'body', 'go', 't'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 40
        && request.resource.data.body is string && request.resource.data.body.size() <= 120;
      allow update, delete: if false;
    }
    match /config/pay {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /grants/{g} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
